# "development" or "production". Anything else, or leaving it out, means
# production: test-account logins and demo payments stay off. Local machines
# must set APP_ENV=development explicitly.
APP_ENV=development
# Development only. Test-account logins (/api/v1/auth/dev-login) and no-charge
# demo payments are on by default when APP_ENV=development; set either to false
# to switch it off. They are always off in production, whatever these say.
TEST_LOGIN_ENABLED=true
DEMO_PAYMENTS_ENABLED=true
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable
CORS_ORIGINS=http://localhost:3000
MIGRATIONS_PATH=migrations
MEDIA_UPLOAD_DIR=storage/media
MEDIA_PUBLIC_BASE_URL=https://api.example.invalid
GOOGLE_CLIENT_IDS=WEB_CLIENT_ID,ANDROID_CLIENT_ID,IOS_CLIENT_ID
FLUTTERWAVE_SECRET_KEY=
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8080

# Owner plan prices in RWF. Blank values keep paid upgrades unavailable.
OWNER_SILVER_PRICE_RWF=10000
OWNER_GOLD_PRICE_RWF=20000
OWNER_PLATINUM_PRICE_RWF=30000

# Use sandbox credentials and URL together, or production credentials and URL together.
MTN_API_USER=
MTN_API_KEY=
MTN_SUBSCRIPTION_KEY_PRIMARY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN's sandbox accepts only EUR. Set MTN_CURRENCY=EUR to test there; prices stay
# in RWF and the amount is sent unchanged. Ignored (always RWF) outside the sandbox.
MTN_CURRENCY=RWF

# Separate MTN SMS v3 product credentials and an approved Rwanda service code.
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SERVICE_CODE=
MTN_SMS_BASE_URL=https://api.mtn.com/v3/sms
MTN_SMS_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token/accesstoken?grant_type=client_credentials

# Optional Twilio fallback. All three values are required to activate it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional, dedicated database used only by integration tests.
TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/TEST_DATABASE?sslmode=disable

# ---------------------------------------------------------------------------
# Database on Supabase: Project -> Connect -> "Session pooler" connection string
# (port 5432, works over IPv4, which Render needs). Don't use the "Transaction
# pooler" (port 6543): it breaks the migration lock and pgx prepared statements.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Verification codes (OTP)

# Secret key used to hash codes. Required (32+ characters). Generate one with:
#   openssl rand -hex 32
# Changing it invalidates codes that were already sent (users just request a new one).
OTP_HMAC_SECRET=

# How many proxies sit in front of this server, used to find the real client IP
# for per-IP rate limits. Vercel -> Render = 2. Calling Render directly = 1.
# 0 = use the TCP connection address (only correct with no proxy at all).
TRUSTED_PROXY_HOPS=0

# SMS via Africa's Talking (tried first). For the sandbox, the username is
# literally "sandbox" and messages only appear in their online simulator.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional approved sender ID / short code. Leave blank to use the default.
AFRICASTALKING_SENDER_ID=
# "sandbox" or "live"
AFRICASTALKING_ENV=sandbox

# Email via any SMTP provider (Brevo, Resend, Mailgun, ...).
# Port 587 = STARTTLS, port 465 = TLS. EMAIL_FROM must be an address on a domain
# you have verified with the provider, e.g.  Umutungo <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
