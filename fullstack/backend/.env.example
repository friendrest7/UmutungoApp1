APP_ENV=development
PORT=8080
DATABASE_URL=postgres://umutungo:umutungo@localhost:5432/umutungo?sslmode=disable
CORS_ORIGINS=http://localhost:3000
MIGRATIONS_PATH=migrations
MEDIA_UPLOAD_DIR=storage/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_IDS=947964372839-5mbve9eh4k07qpqkvm0h7cp35tm9rj8o.apps.googleusercontent.com,128904720035-13hdispbjdum6iphqb3e1ct5ohmdnkb1.apps.googleusercontent.com

# Owner one-time premium plan prices (RWF). Purchases are disabled for any unset price.
OWNER_SILVER_PRICE_RWF=
OWNER_GOLD_PRICE_RWF=
OWNER_PLATINUM_PRICE_RWF=

# MTN MoMo Collection credentials (keep these on the backend; never put them in the app).
MTN_API_USER=
MTN_API_KEY=
MTN_SUBSCRIPTION_KEY_PRIMARY=
# Sandbox credentials: sandbox / https://sandbox.momodeveloper.mtn.com.
# For approved Rwanda production credentials, set mtnrwanda / https://momoapi.mtn.com.
MTN_TARGET_ENVIRONMENT=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com

# MTN SMS v3 credentials are separate from the MoMo Collection API user/key above.
# The SMS app must be subscribed to SMS v3 for Rwanda and have an approved service code.
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SERVICE_CODE=
MTN_SMS_BASE_URL=https://api.mtn.com/v3/sms
MTN_SMS_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token/accesstoken?grant_type=client_credentials
