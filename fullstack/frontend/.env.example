# Optional. Keep provider keys server-side; GROQ_API_KEY is read only by route handlers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Vercel AI Gateway configuration. VERCEL_OIDC_TOKEN is supplied by Vercel when configured.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-oss-20b

# Backend API origin. Configure these in Vercel for deployed server routes and browser requests.
BACKEND_API_URL=https://api.example.invalid
NEXT_PUBLIC_API_URL=https://api.example.invalid

# Public OAuth client ID; this is an identifier, not a client secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=WEB_CLIENT_ID.apps.googleusercontent.com
# Optional legacy alias; only use it when the primary client ID above is unset.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=WEB_CLIENT_ID.apps.googleusercontent.com
