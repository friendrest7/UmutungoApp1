{
  "expo": {
    "name": "Umutungo",
    "slug": "umutungo-mobile",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "scheme": "umutungo",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7faf7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "rw.umutungo.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "rw.umutungo.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0b6b3a"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Umutungo to scan a MoMo phone number QR code.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withAndroidNativeRuntime"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e3a637b3-8746-47e2-9d5a-6c1c9322031a"
      }
    },
    "owner": "friendrest7"
  }
}
