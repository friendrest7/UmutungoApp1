{
  "name": "umutungo-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:simulator": "eas build --platform ios --profile ios-simulator",
    "build:ios:production": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.20",
    "expo-image-picker": "~17.0.0",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.3.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.18.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "jest": "^30.0.0",
    "jest-expo": "~57.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
